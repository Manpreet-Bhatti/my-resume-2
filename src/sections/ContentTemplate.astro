---
import { FiLink, FiGithub } from 'react-icons/fi';

interface Props {
  title: string;
  subtitle?: string;
  aside?: string;
  home?: string;
  github?: string;
}
const { title, subtitle, aside, home, github } = Astro.props;
---
<div>
  <h3
    class="mb-[0.025in] mt-[0.05in] flex items-center justify-between text-sm font-medium text-primary dark:text-dark-primary"
  >
    <div class="flex items-center gap-x-1">
      {title}
      {
        home && (
          <a
            href={home}
            target="_blank"
            rel="noreferrer noopener"
            aria-label={title}
            class="dark:hover:bg-dark-hover-page dark:active:bg-dark-active-page rounded-md p-2 transition-colors duration-200 hover:bg-hover-page active:bg-active-page"
          >
            <FiLink className="h-3 w-3 text-primary dark:text-dark-primary" />
          </a>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noreferrer noopener"
            aria-label={title}
            class="dark:hover:bg-dark-hover-page dark:active:bg-dark-active-page rounded-md p-2 transition-colors duration-200 hover:bg-hover-page active:bg-active-page"
          >
            <FiGithub className="h-3 w-3 text-primary dark:text-dark-primary" />
          </a>
        )
      }
    </div>
    {!subtitle && aside && <p class="text-xs text-alt-text dark:text-dark-alt-text">{aside}</p>}
  </h3>
  {
    subtitle && (
      <div class="-mt-1.5 flex justify-between text-xs font-medium">
        <p class="dark:text-dark-text">{subtitle}</p>
        {aside && <p class="text-alt-text dark:text-dark-alt-text">{aside}</p>}
      </div>
    )
  }
  <div class="mt-1.5 text-sm leading-[1.5] text-alt-text dark:text-dark-alt-text">
    <slot />
  </div>
</div>
